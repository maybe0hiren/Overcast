# Overcast Docker Backend Configuration

# Primary LAN HTTP port exposed on the Debian host (default 80 so http://<IP> works directly)
OVERCAST_PORT=80

# Secondary port exposed on the host (default 8000 so http://<IP>:8000 also works)
OVERCAST_ALT_PORT=8000

# Host directory for persistent user files, SQLite database, previews, and temp chunks
OVERCAST_DATA_DIR=./data

# Chunked upload settings (default chunk size: 4 MiB, max upload: 20 GiB)
CHUNK_SIZE=8388608
CHUNK_UPLOAD_SIZE=4194304
MAX_UPLOAD_SIZE=21474836480
UPLOAD_SESSION_TTL_SECONDS=86400
MAX_ACTIVE_UPLOAD_SESSIONS=150

# Gunicorn worker configuration
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=600

# Optional custom sharing base URL (leave blank to auto-detect from request host)
SHARING_ENDPOINT=
